---
import Character from './Character.astro';
import CopyRights from './CopyRights.astro';
import { PERSON, SOCIALS, STACKOVERFLOW_URL, RESUME_PATH } from '../../config/site';

const linkClass =
  'mr-[20px] relative text-[16px] leading-[24px] transition-all text-textDullest hover:text-darkBackground2 py-[15px]';
---

{/*
  Was <section>. This is the page's footer, so <footer> is the correct element —
  it also produces the "contentinfo" landmark that screen-reader users navigate
  to for contact details, and which Lighthouse checks for.
*/}
<footer
  class="fixed_footer bg-darkBackground md:flex md:items-center md:gap-[5vw] px-pageXMobile md:px-pageX pt-[110px] pb-[60px] md:pb-[90px] w-full"
>
  <div>
    <h2
      class="text-textLightPrimary text-center md:text-left mb-[50px] text-[30px] md:text-[50px] lg:text-[4rem] leading-[1.133em] lg:leading-[1.33em] font-bold"
    >
      Bug Me!
    </h2>

    <a
      href={`mailto:${PERSON.email}`}
      class="interactable interactable-link text-textLightPrimary text-center md:text-left block uppercase mb-[40px]"
      aria-label={`Email ${PERSON.name}`}>{PERSON.email}</a
    >

    {/*
      Wrapped in <nav>: this is a labelled set of navigation links, not a bare
      div of anchors. Facebook and Instagram are included here so the profiles
      declared in the JSON-LD `sameAs` array are also reachable as real,
      crawlable links — Google cross-checks the two.
    */}
    <nav
      aria-label={`${PERSON.name} profiles and documents`}
      class="interactable interactable-link text-center md:text-left mb-[20px] md:mb-[80px]"
    >
      <a href={SOCIALS.linkedin} rel="noopener noreferrer me" target="_blank" class={linkClass}>
        LinkedIn
      </a>
      <a href={SOCIALS.github} rel="noopener noreferrer me" target="_blank" class={linkClass}>
        Github
      </a>
      <a href={SOCIALS.instagram} rel="noopener noreferrer me" target="_blank" class={linkClass}>
        Instagram
      </a>
      <a href={SOCIALS.facebook} rel="noopener noreferrer me" target="_blank" class={linkClass}>
        Facebook
      </a>
      <a href={STACKOVERFLOW_URL} rel="noopener noreferrer" target="_blank" class={linkClass}>
        Stackoverflow
      </a>
      <a href={RESUME_PATH} rel="noopener noreferrer" target="_blank" class={linkClass}>
        Resume
      </a>
    </nav>

    <!-- Moving Text -->
    <div class="flex justify-center md:block">
      <CopyRights text={`©${PERSON.name}. All Rights Reserved`} />
    </div>
  </div>
  <div class="flex-1 opacity-[0.35] hidden md:block" aria-hidden="true">
    <Character />
  </div>
</footer>

<style>
  .fixed_footer {
    position: relative;
    z-index: 1;
  }
</style>
