{/*
  aria-hidden + inert: the preloader is a purely decorative intro. Leaving it in
  the accessibility tree meant screen readers announced "Curious Creative
  Adaptive Passionate Engineer" before any real content, and keyboard focus
  could land inside an overlay the user cannot see past.
*/}
<div class="preloder-container" aria-hidden="true">
  <div class="preloder-text-wrapper fixed h-[100vh] text-[4rem] md:text-[7rem] lg:text-[8rem] w-full z-30 flex items-center justify-center">
    <div class="preloader-text-inner opacity-0 text-white">
      <p>Curious</p>
      <p>Creative</p>
      <p>Adaptive</p>
      <p>Passionate</p>
      <p class="text-primary">Engineer</p>
    </div>
  </div>
  <div class="preloader-overlay fixed w-full h-[100vh] z-10 flex">
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
    <div class="bar w-[10vw] h-[105vh] bg-[#181818] leading-0 text-center m-0 p-0"></div>
  </div>
</div>

<style>
  .preloder-container p{
    text-align: center;
    margin: 0;
    line-height: 0;
  }
</style>

<script>
  import gsap from 'gsap';
  import SplitType from 'split-type';

  /*
   * PERFORMANCE — this was the site's biggest Core Web Vitals problem.
   *
   * The old timeline held a full-screen opaque overlay in front of the page for
   * 6 seconds (bars cleared at 4.5s, wrapper at 5s, overlay at 6s), while the
   * hero animated in at delay 6–6.5s. Nothing meaningful was painted until
   * ~7s, so Largest Contentful Paint was ~7s against a 2.5s "good" threshold —
   * no amount of asset optimisation could rescue the score with this in place.
   *
   * The intro is preserved, just at a realistic tempo: bars clear at 0.75s and
   * the overlay is gone by ~1.2s, which is in line with the hero animation
   * delays in MainTitle/HeaderSection. Users who prefer reduced motion, and
   * anyone arriving at a #hash deep link, skip it entirely.
   */
  const preloaderContainer = document.querySelector<HTMLElement>('.preloder-container');
  const preloaderWrapper = document.querySelector('.preloder-text-wrapper');
  const preloadInner = document.querySelector('.preloader-text-inner');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDeepLink = window.location.hash.length > 1;

  if (prefersReducedMotion || isDeepLink) {
    preloaderContainer?.remove();
  } else {
    const titles = gsap.utils.toArray<HTMLElement>('.preloder-container p');
    const tl = gsap.timeline({ repeat: -1 });

    gsap.to(preloadInner, { delay: 0.1, duration: 0.2, opacity: 1 });

    // Staggering 3D effect
    titles.forEach((title) => {
      const splitTitle = new SplitType(title, { types: 'chars' });
      tl.from(
        splitTitle.chars,
        { opacity: 0, y: 80, rotateX: -90, stagger: 0.012, duration: 0.35 },
        '<'
      ).to(
        splitTitle.chars,
        { opacity: 0, y: -80, rotateX: 90, stagger: 0.008, duration: 0.3 },
        '<0.34'
      );
    });

    gsap.to(preloaderWrapper, {
      delay: 0.85,
      duration: 0.1,
      opacity: 0,
      height: 0,
      width: 0,
      display: 'none',
    });

    gsap.to('.bar', {
      delay: 0.55,
      duration: 0.6,
      height: 0,
      stagger: { amount: 0.3 },
      ease: 'power4.inOut',
    });

    gsap.to('.preloader-overlay', {
      delay: 1.15,
      duration: 0.1,
      opacity: 0,
      height: 0,
      width: 0,
      display: 'none',
      // Take the whole overlay out of the DOM once it has played, so it can
      // never intercept pointer events or repaint later.
      onComplete: () => preloaderContainer?.remove(),
    });
  }
</script>