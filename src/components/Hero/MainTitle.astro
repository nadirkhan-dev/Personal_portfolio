---
import BrandsIWorkWith from './BrandsIWorkWith.astro';
import SocialIcon from './SocialIcon.astro';
import { PERSON } from '../../config/site';
---

{/*
  Was <main>, now <div>: <main> belongs once per page and now wraps the whole
  page in index.astro. Two <main> landmarks is an accessibility failure.
*/}
<div
  class="flex flex-col md:flex-row justify-center
  md:justify-between text-textLight h-[calc(100vh-10rem)]
  md:mb-pageBottomTab lg:mb-pageBottom gap-10 md:gap-0"
>
  {/*
    The page's single <h1>.

    Previously the inner <div>s each carried role="heading" aria-level="1",
    which announced FOUR separate level-1 headings to screen readers and gave
    Google four competing page titles. They are now plain <span>s inside one
    real <h1>.

    The visible words stay exactly as designed. The .sr-only span puts the
    actual subject of the page — "Nadir Khan, Full Stack Developer" — inside
    the h1 where crawlers and screen readers both read it. This is not cloaking:
    the text is truthful, matches the <title>, meta description, About section
    and footer, and is exposed to assistive technology rather than hidden from it.
  */}
  <h1
    class="main-title flex flex-col md:items-start self-center md:self-end
    text-center justify-center md:justify-end uppercase
    text-[4rem] md:text-[6rem] lg:text-[8.75rem] font-[800]
    leading-[50px] md:leading-[90px] lg:leading-[110px]"
  >
    <span class="sr-only">{PERSON.name} — {PERSON.jobTitle}.</span>
    <span class="relative">Building</span>
    <span class="tagline bg-primary -rotate-2 p-[8px] md:px-[0.8rem] lg:p-4">
      <span class="block text-background text-[4rem] md:text-[5rem] lg:text-[8rem] relative">
        Modern UIs
      </span>
    </span><span>Since</span><span>2025</span>
  </h1>

  <!-- social links -->
  <div class="self-center md:self-end flex flex-col items-center md:items-end gap-14">
    <!-- hidden on mobile -->
    <div class="hidden md:block">
      <BrandsIWorkWith />
    </div>
    <SocialIcon />
  </div>
</div>

<style>
  @media (min-width: 320px) and (max-width: 370px) {
    .main-title {
      font-size: 3.4rem;
    }
    .main-title .tagline span {
      font-size: 3.4rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The hero h1 is the LCP element on most viewports. Animating it in after a
  // long delay meant LCP was reported at the END of the animation. Delays are
  // now short enough that the intro still reads as an intro without pushing
  // LCP past the 2.5s "good" threshold, and are skipped entirely for users
  // who prefer reduced motion.
  if (!prefersReducedMotion) {
    gsap.from('h1.main-title', {
      y: 50,
      opacity: 0,
      ease: 'power4.inOut',
      delay: 1.1,
      duration: 0.7,
      stagger: { amount: 0.3 },
    });

    gsap.from('h1.main-title .tagline', {
      x: -100,
      opacity: 0,
      ease: 'power3.inOut',
      delay: 1.25,
      duration: 0.7,
      stagger: { amount: 0.2 },
    });
  }
</script>
