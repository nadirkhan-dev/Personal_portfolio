---
import ProjectsView from './ProjectsView.astro';
import type { Project } from '../../data/projects';
import { PERSON } from '../../config/site';

interface Props {
  /**
   * Supplied by the page. Data fetching moved to src/data/projects.ts so the
   * same array also feeds the SoftwareSourceCode JSON-LD without a second fetch.
   */
  projects: Project[];
}

const { projects } = Astro.props;
---

{/*
  id="projects" is the anchor target used by the manifest shortcut and the 404
  page. The heading is visually hidden because the design already announces this
  section with the marquee above it — but a section landmark with no accessible
  name is meaningless to screen readers and gives Google no topical label.
*/}
<section id="projects" aria-labelledby="projects-heading" class="w-full dark-trailer relative z-30">
  <h2 id="projects-heading" class="sr-only">
    Projects built by {PERSON.name}
  </h2>
  {
    projects.map((project: Project, index: number) => (
      <ProjectsView project={project} index={index} totalLength={projects.length} />
    ))
  }
</section>
