---
import Icon from 'astro-icon';
import type { Project } from '../../data/projects';

interface ProjectsProps {
  project: Project;
  index: number;
  totalLength: number;
}

const { project, index, totalLength } = Astro.props;
const primaryUrl = project.links?.[0]?.url ?? project.url;
const hasLink = Boolean(primaryUrl);

const posterSrc = project.posterImage;
const videoSrc = project.videoUrl;

// Intrinsic dimensions, used to reserve the exact layout box before the media
// loads. Without these the page reflows as each poster arrives — the main
// source of Cumulative Layout Shift on this page.
const posterWidth = project.posterWidth ?? 1280;
const posterHeight = project.posterHeight ?? 720;

const headingId = `project-${project._id}-title`;
---

{/*
  Was <section> wrapping <div>s. Each project is a self-contained, independently
  distributable piece of content, which is exactly what <article> means. It is
  labelled by its own heading so screen readers announce "article, <project name>".
*/}
<article
  aria-labelledby={headingId}
  class:list={[
    'project-section bg-white px-pageXMobile md:px-pageX relative',
    { 'pt-[40px] md:pt-[0px]': index === 0 },
    { 'pb-[40px] md:pb-[0px]': index == totalLength - 1 },
  ]}
>
  <div
    class:list={[
      `flex flex-col lg:flex-row items-center h-full py-[40px] md:py-[80px]`,
      { 'md:border-b md:border-[#efefef]': index !== totalLength - 1 },
    ]}
  >
    <div>
      <!-- project section -->
      <div class="flex flex-col lg:flex-row items-center gap-0 md:gap-10 lg:gap-40">
        <!-- project description -->
        <div class="max-w-full w-full lg:max-w-[30%] flex flex-col">
          <p
            class="reveal-type text-background hidden lg:block text-[1rem] font-[700] mb-7 leading-[1.5rem] uppercase"
          >
            Project
          </p>
          {/*
            Was a <div>. Project names are the most valuable keyword-bearing text
            in this section; as a real <h3> they sit correctly under the section's
            <h2> and are treated as headings rather than anonymous text.
          */}
          <h3
            id={headingId}
            class="reveal-type text-background text-[35px] md:text-[50px] lg:text-[4rem]
             font-bold uppercase leading-[40px] md:leading-[65px] mb-[30px] md:mb-[20px] lg:mb-8"
          >
            {project.name}
          </h3>
          <p
            class="hidden reveal-type text-background text-[16px] capitalize mb-[30px] md:mb-[20px] lg:mb-8"
          >
            {project.category}
          </p>
          <p
            class="reveal-type text-[1rem] md:text-[20px] block lg:text-[22px] md:leading[30px] lg:leading-[27px] mb-8 text-background"
          >
            {project.description}
          </p>
          {
            project.links && project.links.length > 0 ? (
              <div class="hidden lg:flex flex-wrap gap-3">
                {project.links.map((link) => (
                  <a
                    href={link.url}
                    class="interactable interactable-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${link.label} — ${project.name} (opens in a new tab)`}
                  >
                    <span class="border-black border-2 text-black px-6 py-4 w-max rounded-full text-[14px] md:text-[16px] group font-bold uppercase leading-[1.5rem] flex items-center gap-2 transition-all">
                      {link.label}
                      <span>
                        <Icon
                          name="gg:arrow-right"
                          class="w-[26px] group-hover:-rotate-45 transition-all"
                        />
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            ) : hasLink ? (
              <a
                href={primaryUrl}
                class="interactable interactable-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`See ${project.name} in action (opens in a new tab)`}
              >
                <span class="border-black border-2 text-black px-6 py-4 w-max rounded-full text-[16px] group font-bold uppercase leading-[1.5rem] hidden lg:flex items-center gap-2 transition-all">
                  See in action
                  <span>
                    <Icon
                      name="gg:arrow-right"
                      class="w-[30px] group-hover:-rotate-45 transition-all"
                    />
                  </span>
                </span>
              </a>
            ) : null
          }
        </div>

        <!-- project media -->
        <div class="w-full flex-1">
          {hasLink ? (
            <a
              href={primaryUrl}
              aria-label={`${project.name} (opens in a new tab)`}
              class="interactable interactable-link block"
              target="_blank"
              rel="noopener noreferrer"
            >
              {videoSrc ? (
                <video
                  poster={posterSrc}
                  class="project-video lazy w-full h-auto"
                  width={posterWidth}
                  height={posterHeight}
                  loop
                  data-src={videoSrc}
                  muted
                  playsinline
                  preload="none"
                  aria-label={`Screen recording of ${project.name}`}
                >
                  <source data-src={videoSrc} type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
              ) : (
                <img
                  src={posterSrc}
                  alt={`Screenshot of ${project.name} built by Nadir Khan`}
                  class="w-full h-auto"
                  width={posterWidth}
                  height={posterHeight}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </a>
          ) : videoSrc ? (
            <video
              poster={posterSrc}
              class="project-video lazy w-full h-auto"
              width={posterWidth}
              height={posterHeight}
              loop
              data-src={videoSrc}
              muted
              playsinline
              preload="none"
              aria-label={`Screen recording of ${project.name}`}
            >
              <source data-src={videoSrc} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          ) : (
            <img
              src={posterSrc}
              alt={`Screenshot of ${project.name} built by Nadir Khan`}
              class="w-full h-auto"
              width={posterWidth}
              height={posterHeight}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  import gsap from 'gsap';
  import LazyLoad from 'vanilla-lazyload';
  import { ScrollTrigger } from 'gsap/all';
  import SplitType from 'split-type';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    // Line-by-line reveal for text marked with .reveal-type
    const splitTypes = document.querySelectorAll('.reveal-type');

    splitTypes.forEach((char) => {
      const text = new SplitType(char as HTMLElement, { types: 'lines' });

      gsap.from(text.lines, {
        scrollTrigger: {
          trigger: char,
          start: 'top 80%',
          end: 'top 40%',
          scrub: false,
        },
        ease: 'power4.out',
        scaleY: 0,
        y: 50,
        transformOrigin: 'top',
        stagger: 0.2,
        duration: 0.5,
      });
    });
  }

  // Threshold reduced from 1500px to 300px. The videos are 11–12 MB each; the
  // old value started downloading all of them almost immediately, competing
  // with the hero image for bandwidth and wrecking LCP on slower connections.
  const lazy = new LazyLoad({ threshold: 300 });
  lazy.update();

  // Play a project video only while it is on screen, and only once its source
  // has actually been swapped in by LazyLoad.
  const videos = document.querySelectorAll<HTMLVideoElement>('.project-video');

  if (videos.length > 0) {
    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            // play() rejects if the media is not ready or autoplay is blocked;
            // an unhandled rejection here surfaces as a console error.
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.2 }
    );

    videos.forEach((video) => videoObserver.observe(video));
  }
</script>
