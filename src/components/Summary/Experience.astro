---
// Single computed value; the duplicate id="experience" that used to sit on the
// span below is gone (that id already existed twice in HeaderSideText, making
// three elements share one id — invalid HTML).
const yearsOfExperience = new Date().getFullYear() - 2025;
---

<section
  id="experience"
  aria-labelledby="experience-heading"
  class="py-[70px] md:py-[80px] lg:py-[100px] flex flex-col lg:flex-row justify-between border-b border-darkBorder"
>
  <div>
    <h2
      id="experience-heading"
      class="text-[30px] md:text-[50px] lg:text-[4rem] leading-[70px] lg:leading-[80px] font-bold mb-[30px] text-textLightPrimary"
    >
      Experience
    </h2>
    <ul
      class="list-none p-0 m-0 max-w-none lg:max-w-[310px] text-textDullest text-[1rem] leading-[1.5em] mb-[40px]"
    >
      <li>Full Stack Web Development</li>
      <li>Shipping Carrier Integrations</li>
      <li>CMS Integration &amp; Workflows</li>
      <li>RESTful API Development</li>
      <li>Scalable Component Architecture</li>
      <li>Git and GitHub Collaboration</li>
      <li>Agile / Scrum Methodology</li>
      <li>Performance-focused UX</li>
      <li>Production-ready Delivery</li>
    </ul>
  </div>
  <div class="ml-0 lg:ml-[80px] max-w-none md:max-w-[80%] lg:max-w-[61%] w-full">
    <h3
      class="text-[22px] md:text-[24px] leading-[30px] md:leading-[34px] mb-[30px] text-textLightPrimary"
    >
      Quick summary of my career:
    </h3>
    <ul
      class="list-none p-0 m-0 text-[30px] md:text-[50px] lg:text-[4rem] leading-[40px] md:leading-[60px] lg:leading-[80px] text-textLightPrimary"
    >
      <li>{yearsOfExperience}+ years dev experience</li>
      <li>Frontend / Full Stack Developer at Algotix.ai</li>
      <li>Jan 2025 - Present</li>
      <li>Full Stack Web Application Delivery</li>
    </ul>
  </div>
</section>
