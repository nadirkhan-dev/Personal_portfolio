---
import AboutMe from './AboutMe.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Achievements from './Achievements.astro';
import { PERSON } from '../../config/site';
---

<!-- Wrapper carries an accessible name so the grouping landmark is not anonymous. -->
<div
  role="region"
  aria-label={`About ${PERSON.name}`}
  class="summary z-30 relative bg-black px-pageXMobile md:px-pageX"
>
  <AboutMe />
  <Experience />
  <Skills />
  <Achievements />
</div>
