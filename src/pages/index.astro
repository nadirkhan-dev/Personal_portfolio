---
import Layout from '../layouts/Layout.astro';
import StructuredData from '../components/SEO/StructuredData.astro';
import HeroSection from '../components/Hero/HeroSection.astro';
import Summary from '../components/Summary/Summary.astro';
import Footer from '../components/Footer/Footer.astro';
import MouseTrailer from '../components/MouseTrailer/MouseTrailer.astro';
import WhyWorkWithMe from '../components/WhyWorkWithMe/WhyWorkWithMe.astro';
import Marquee from '../components/Marquee/Marquee.astro';
import Preloader from '../components/Preloader/Preloader.astro';
import Projects from '../components/Projects/Projects.astro';
import { PAGES } from '../config/site';
import { getProjects } from '../data/projects';

// Fetched once here and shared by the rendered section and the JSON-LD, so the
// markup and the structured data are guaranteed to describe the same projects.
const projects = await getProjects();

const { title, description, path } = PAGES.home;
---

<Layout
  title={title}
  description={description}
  path={path}
  ogType="profile"
  preloadImage="/nadir-hero.webp"
>
  <StructuredData path={path} title={title} description={description} projects={projects} />

  <Preloader />
  <MouseTrailer />

  <main id="main-content">
    <div class="section-reveal">
      <HeroSection />
    </div>

    {/* Story section — temporarily disabled (commented out, not removed)
    <div class="block md:hidden">
      <Marquee text="The Story I told my wife" />
    </div>
    <Story />
    */}

    <div class="section-reveal">
      <Marquee text="My Projects I Work On" />
    </div>
    <div class="section-reveal">
      <Projects projects={projects} />
    </div>
    <div class="section-reveal">
      <Marquee text="A Developer With Magical Touch" />
    </div>
    <div class="section-reveal">
      <WhyWorkWithMe />
    </div>
    <div class="section-reveal">
      <Marquee text="Lorem ipsum dolor? Just Kidding" />
    </div>
    <div class="section-reveal">
      <Summary />
    </div>
  </main>

  <div class="section-reveal">
    <Footer />
  </div>
</Layout>
